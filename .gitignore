agent/config.test.json
agent/config.bad.json

# --- moderation log (driver-local, holds prompt snippets -- never commit) ---
safety/*.log
ui/*.log

# --- coordinator runtime state / secrets (never commit) ---
# SQLite DB holds real node auth tokens — must never be pushed
*.db
*.db-wal
*.db-shm
coordinator/node_tokens.json
coordinator/nodes.local.json

# --- private / pre-public docs (keep out of the public repo) ---
TOKENOMICS.md

# --- SSH / private keys (NEVER commit — belt-and-suspenders) ---
*.key
*.pem
ssh-key-*
id_rsa*
id_ed25519*
*_rsa
*.ppk

# --- PyInstaller build output (multi-GB — bundles torch; never commit) ---
build/
dist/
*.manifest

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
agent/config.node-*.json
model_slice_*/

