# --- Python virtualenv (multi-GB — never commit) ---
.venv/
venv/
env/

# --- Byte-compiled / cache ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Secrets / environment ---
.env
.env.*
*.env

